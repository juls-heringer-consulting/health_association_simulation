            "jsonSpec": {
              "expr": {
                "Literal": {
                  "Value": "'{\n  \"$schema\": \"https://vega.github.io/schema/vega-lite/v6.json\",\n  \"description\": \"Yearly growth in active doctors, Fachgruppe x year.\",\n  \"data\": {\n    \"name\": \"dataset\"\n  },\n  \"width\": \"container\",\n  \"height\": \"container\",\n  \"transform\": [\n    {\n      \"filter\": \"isValid(datum[''Doctor Growth YoY'']) && isFinite(datum[''Doctor Growth YoY''])\"\n    },\n    {\n      \"calculate\": \"datum[''Doctor Growth YoY'']\",\n      \"as\": \"g\"\n    }\n  ],\n  \"mark\": {\n    \"type\": \"rect\",\n    \"stroke\": \"#fcfcfb\",\n    \"strokeWidth\": 1.5,\n    \"cornerRadius\": 2\n  },\n  \"encoding\": {\n    \"x\": {\n      \"field\": \"Year\",\n      \"type\": \"ordinal\",\n      \"title\": null,\n      \"axis\": {\n        \"orient\": \"top\",\n        \"labelAngle\": 0,\n        \"labelExpr\": \"''’'' + substring(datum.label, 2)\"\n      }\n    },\n    \"y\": {\n      \"field\": \"fachgruppe\",\n      \"type\": \"nominal\",\n      \"title\": null,\n      \"sort\": {\n        \"field\": \"g\",\n        \"op\": \"median\",\n        \"order\": \"descending\"\n      }\n    },\n    \"color\": {\n      \"field\": \"g\",\n      \"type\": \"quantitative\",\n      \"title\": \"Growth\",\n      \"scale\": {\n        \"domainMid\": 0,\n        \"range\": [\n          \"#e34948\",\n          \"#f9f9f7\",\n          \"#2a78d6\"\n        ],\n        \"interpolate\": \"rgb\"\n      },\n      \"legend\": {\n        \"format\": \".0%\",\n        \"orient\": \"bottom\",\n        \"direction\": \"horizontal\",\n        \"gradientLength\": 200,\n        \"titleOrient\": \"left\"\n      }\n    },\n    \"tooltip\": [\n      {\n        \"field\": \"fachgruppe\",\n        \"type\": \"nominal\",\n        \"title\": \"Fachgruppe\"\n      },\n      {\n        \"field\": \"Year\",\n        \"type\": \"ordinal\",\n        \"title\": \"Year\"\n      },\n      {\n        \"field\": \"g\",\n        \"type\": \"quantitative\",\n        \"title\": \"Growth\",\n        \"format\": \".1%\"\n      },\n      {\n        \"field\": \"Active Doctors (Year End)\",\n        \"type\": \"quantitative\",\n        \"title\": \"Active doctors (year end)\",\n        \"format\": \",\"\n      }\n    ]\n  }\n}'"
                }
              }
