		lineageTag: 462c2e0f-99ab-55e4-b950-c6a5e09dc183
		summarizeBy: sum
		sourceColumn: ist_aerzte

		annotation SummarizationSetBy = Automatic

	column status
		dataType: string
		lineageTag: 709812c7-0be2-5c55-ad27-1d90a4e9857f
		summarizeBy: none
		sourceColumn: status

	column Stichtag = VAR k = fact_versorgungsgrad[stichtag_key] RETURN DATE(INT(k / 10000), MOD(INT(k / 100), 100), MOD(k, 100))
		dataType: dateTime
		formatString: dd.MM.yyyy
		lineageTag: b37b318e-f66d-55e9-970b-0f254681ef8c
		summarizeBy: none

	partition fact_versorgungsgrad = m
		mode: import
		source =
				let
					Source = Sql.Database(ServerName, DatabaseName),
					Data = Source{[Schema = "mart", Item = "fact_versorgungsgrad"]}[Data],
					Selected = Table.SelectColumns(Data, {"stichtag_key", "planungsbereich_key", "arztgruppe_key", "einwohner", "soll_aerzte", "ist_aerzte", "status"}),
					Known = Selected,
					Result = Known
				in
