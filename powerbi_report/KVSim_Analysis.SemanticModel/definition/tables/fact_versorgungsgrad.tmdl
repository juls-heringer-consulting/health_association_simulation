table fact_versorgungsgrad
	lineageTag: a4598dc1-bc03-58bc-8a36-52e018ac3fd0

	measure 'Supply Level' = VAR s = MAX(fact_versorgungsgrad[stichtag_key]) RETURN CALCULATE(DIVIDE(SUM(fact_versorgungsgrad[ist_aerzte]), SUM(fact_versorgungsgrad[soll_aerzte])), fact_versorgungsgrad[stichtag_key] = s)
		formatString: 0.0%
		lineageTag: 7cc71dc0-80e0-5401-ac71-434aa6f3514f

	measure 'Areas Open' = VAR s = MAX(fact_versorgungsgrad[stichtag_key]) RETURN CALCULATE(COUNTROWS(fact_versorgungsgrad), fact_versorgungsgrad[stichtag_key] = s, fact_versorgungsgrad[status] = "OFFEN") + 0
		formatString: #,0
		lineageTag: db6476d6-60df-5780-981c-898dd09ae467

	measure 'Areas Closed' = VAR s = MAX(fact_versorgungsgrad[stichtag_key]) RETURN CALCULATE(COUNTROWS(fact_versorgungsgrad), fact_versorgungsgrad[stichtag_key] = s, fact_versorgungsgrad[status] = "GESPERRT") + 0
		formatString: #,0
		lineageTag: 631124d8-7580-5ee1-9373-275bd9e587ce

	measure 'Areas Undersupplied' = VAR s = MAX(fact_versorgungsgrad[stichtag_key]) RETURN CALCULATE(COUNTROWS(fact_versorgungsgrad), fact_versorgungsgrad[stichtag_key] = s, fact_versorgungsgrad[status] = "UNTERVERSORGT") + 0
		formatString: #,0
		lineageTag: a135ff38-13c1-50b9-bd72-1594e3fed426

	column stichtag_key
		dataType: int64
		isHidden
		lineageTag: ab25f366-2d2b-5775-9a73-da596e8f9578
		summarizeBy: none
		sourceColumn: stichtag_key

	column planungsbereich_key
		dataType: int64
		isHidden
		lineageTag: c1b83e6a-5c4b-51a2-9be1-960e40cca592
		summarizeBy: none
		sourceColumn: planungsbereich_key

	column arztgruppe_key
		dataType: int64
		isHidden
		lineageTag: 2a7e0c93-9039-5e8b-ae03-52e3eaece9c3
		summarizeBy: none
		sourceColumn: arztgruppe_key

	column einwohner
		dataType: int64
		isHidden
		formatString: #,0
		lineageTag: b52bd509-0111-54a7-8865-db08c4ac8f27
		summarizeBy: none
		sourceColumn: einwohner

	column soll_aerzte
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: c0f64f5a-e536-5721-b5b8-7f4a46d7f25d
		summarizeBy: sum
		sourceColumn: soll_aerzte

		annotation SummarizationSetBy = Automatic

	column ist_aerzte
		dataType: double
		isHidden
