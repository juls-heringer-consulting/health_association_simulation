table fact_honorar_quartal
	lineageTag: 0ff4b7c2-43f4-5ee3-8f00-9cbeeef7809f

	measure 'Honorar Brutto' = SUM(fact_honorar_quartal[honorar_brutto])
		formatString: #,0 "€"
		lineageTag: 841c2bb7-76aa-539c-931b-54ba4bbfea3d

	measure Payout = SUM(fact_honorar_quartal[auszahlungsbetrag])
		formatString: #,0 "€"
		lineageTag: bbc1fb91-9d13-5ede-b9a5-4dd4c36297c6

	measure 'Admin Costs' = SUM(fact_honorar_quartal[verwaltungskosten])
		formatString: #,0 "€"
		lineageTag: 634eb412-f1ef-54a0-8dd4-cee3e14803ec

	measure 'Advance Payments' = SUM(fact_honorar_quartal[abschlaege_gezahlt])
		formatString: #,0 "€"
		lineageTag: face3ee7-f0f1-5449-a15a-2805c17df571

	measure MGV = SUM(fact_honorar_quartal[betrag_mgv])
		formatString: #,0 "€"
		lineageTag: 12df1082-1eee-51da-b59f-4c695af2bb1b

	measure EGV = SUM(fact_honorar_quartal[betrag_egv])
		formatString: #,0 "€"
		lineageTag: aa91fff3-899b-5d8e-91c7-86d922fa3a92

	measure 'EGV Share' = DIVIDE([EGV], [Honorar Brutto])
		formatString: 0.0%
		lineageTag: 657af2ff-cf69-5a36-a862-deb962be247e

	measure 'Honorar Bridge' = VAR s = SELECTEDVALUE('Honorar Step'[Sort]) RETURN SWITCH(s, 1, [Honorar Brutto], 2, -[Admin Costs], 3, -[Advance Payments], [Payout])
		formatString: #,0 "€"
		lineageTag: 7fb7037c-6561-55d0-9ce1-50803952c498

	/// Gross Honorar of the practices that billed cases in the current filter context (e.g. one Fachgruppe).
	/// A practice billing in several Fachgruppen counts fully in each, so values per Fachgruppe do not add up to the total.
	measure 'Honorar Brutto (Practices in Fachgruppe)' = CALCULATE([Honorar Brutto], TREATAS(VALUES(fact_abrechnungsfall[praxis_key]), fact_honorar_quartal[praxis_key]))
		formatString: #,0 "€"
		lineageTag: eed9363d-a2ad-4912-99a5-cdaad0aeebaf

